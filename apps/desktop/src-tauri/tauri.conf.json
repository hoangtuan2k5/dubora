{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "viet-dub",
  "version": "0.1.0",
  "identifier": "dev.hoangtuan.viet-dub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "viet-dub",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "maximized": true,
        "maximizable": true,
        "resizable": true,
        "center": true,
        "backgroundColor": "#080d14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://fonts.googleapis.com https://fonts.gstatic.com; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Hoàng Chiều Nguyễn Tuấn",
    "copyright": "Copyright © 2026 Hoàng Chiều Nguyễn Tuấn <tuan@hoangtuan.dev>",
    "homepage": "https://github.com/hoangtuan2k5/viet-dub",
    "category": "Video",
    "shortDescription": "Vietnamese video dubbing workstation",
    "longDescription": "viet-dub creates Vietnamese dubbed videos from matching video files and SRT subtitles using Azure Speech. Author: Hoàng Chiều Nguyễn Tuấn (tuan@hoangtuan.dev) — https://github.com/hoangtuan2k5",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/ffmpeg/*": "ffmpeg/",
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {}
}
